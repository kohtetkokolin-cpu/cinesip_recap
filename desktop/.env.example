# Cinesip Recap — local settings
# Copy this file to ".env" and fill in the values. ".env" is git-ignored.

# Gemini API key (script step). Real environment variables still win if set.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# LONGMOVIE_GEMINI_MODEL=gemini-3.8-flash
# LONGMOVIE_GEMINI_FALLBACKS=gemini-3.5-flash,gemini-3-flash-preview
# LONGMOVIE_GEMINI_CALL_TIMEOUT=150
# LONGMOVIE_PORT=7861
# LONGMOVIE_PROXY_HEIGHT=360
# LONGMOVIE_GEMINI_CHUNK_SEC=600
# LONGMOVIE_FAKE_GEMINI=0
# LONGMOVIE_FAKE_TTS=0
