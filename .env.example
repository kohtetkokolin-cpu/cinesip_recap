# Copy to .env and fill in. Never commit .env.
# Gemini API key (free tier ~50 req/day per key). Get one at https://aistudio.google.com/
GOOGLE_API_KEY=
# Optional: comma-separated extra keys — the app rotates them automatically
GOOGLE_API_KEYS=
# Whisper model for transcription (Phase 2). tiny = fastest on 4GB RAM, base = better quality
WHISPER_MODEL=tiny
# Optional: token gate for expensive endpoints (leave empty to disable)
APP_TOKEN=
# Optional: custom ffmpeg/ffprobe paths (default: on PATH)
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe
# Gemini model cascade for script writing (comma-separated, tried in order).
# Google retires names often — update here without touching code.
# (Aug 2026: gemini-1.5-*/2.0-* are dead; flash-lite has the biggest free quota)
#GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash
# Gemini TTS model (voice stage)
#GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts
# Speed tuning (parallel workers). Defaults are tuned for a weak laptop.
#VOICE_WORKERS=4
#RENDER_WORKERS=2
#RENDER_THREADS=2
#WHISPER_BEAM=1
